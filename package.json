{
	"name": "newpath",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "本地优先的桌面截图工具（Electron + React + TypeScript）",
	"author": "",
	"license": "UNLICENSED",
	"main": "dist-electron/main.js",
	"scripts": {
		"dev": "node scripts/build-native.mjs --host && vite",
		"dev:ui": "vite --config vite.ui.config.ts",
		"typecheck": "tsc --noEmit --incremental false",
		"test": "vitest run --exclude \"release/**\"",
		"build": "tsc && vite build",
		"verify": "npm run test && npm run build",
		"build:native": "node scripts/build-native.mjs",
		"build:win": "npm run build && electron-builder --win --x64",
		"build:mac": "npm run build:native && npm run build && electron-builder --mac --arm64 --x64",
		"build:linux": "npm run build && electron-builder --linux --x64"
	},
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react": "^6.1.2",
		"autoprefixer": "^10.6.1",
		"electron": "^39.8.10",
		"electron-builder": "^26.15.3",
		"lucide-react": "^1.55.0",
		"postcss": "^8.5.29",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"tailwindcss": "^3.4.19",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "^5.9.3",
		"vite": "^8.3.4",
		"vite-plugin-electron": "^1.1.2",
		"vitest": "^5.0.3"
	},
	"allowScripts": {
		"electron@39.8.10": true,
		"electron-winstaller@5.4.0": true
	}
}
