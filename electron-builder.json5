// electron-builder 配置：https://www.electron.build/configuration
{
	$schema: "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
	appId: "com.newpath.screenshot",
	productName: "NewPath",
	asar: true,
	npmRebuild: false,
	directories: {
		output: "release/${version}",
	},
	files: ["dist", "dist-electron"],
	electronLanguages: ["en", "zh-CN", "zh-TW"],
	win: {
		target: [{ target: "nsis", arch: ["x64"] }],
		icon: "public/icon.png",
		artifactName: "${productName}-Windows-${version}-Setup.${ext}",
	},
	nsis: {
		oneClick: false,
		perMachine: false,
		allowToChangeInstallationDirectory: true,
		createDesktopShortcut: true,
		createStartMenuShortcut: true,
		runAfterFinish: true,
	},
	mac: {
		target: ["dmg"],
		category: "public.app-category.utilities",
		icon: "public/icon.png",
		hardenedRuntime: true,
		extendInfo: {
			// 托盘应用，不显示 Docs 图标
			LSUIElement: true,
			NSScreenCaptureUsageDescription: "NewPath 需要屏幕录制权限来截取屏幕内容。",
		},
		artifactName: "${productName}-Mac-${arch}-${version}.${ext}",
	},
	linux: {
		target: ["AppImage"],
		category: "Graphics",
	},
}
